  <Commands package="guidOpenEditorsPackage">
    <Groups>
      <Group guid="guidOpenEditorsCmdSet" id="OpenEditorsToolWindowGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW" />
      </Group>
      <Group guid="guidOpenEditorsCmdSet" id="OpenEditorsContextMenuGroup" priority="0x0100">
        <Parent guid="guidOpenEditorsCmdSet" id="OpenEditorsContextMenu" />
      </Group>
    </Groups>

    <Menus>
      <Menu guid="guidOpenEditorsCmdSet" id="OpenEditorsContextMenu" priority="0x0100" type="Context">
        <Strings>
          <ButtonText>Open Editors Context Menu</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Buttons>
      <Button guid="guidOpenEditorsCmdSet" id="OpenEditorsToolWindowCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenEditorsCmdSet" id="OpenEditorsToolWindowGroup" />
        <Icon guid="ImageCatalogGuid" id="DocumentGroup" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Open Editors</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOpenEditorsCmdSet" id="OpenEditorsContextSaveCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenEditorsCmdSet" id="OpenEditorsContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Save" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Save Document</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOpenEditorsCmdSet" id="OpenEditorsContextDuplicateCommandId" priority="0x0110" type="Button">
        <Parent guid="guidOpenEditorsCmdSet" id="OpenEditorsContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Copy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Duplicate</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOpenEditorsCmdSet" id="OpenEditorsContextCloseCommandId" priority="0x0120" type="Button">
        <Parent guid="guidOpenEditorsCmdSet" id="OpenEditorsContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Close" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Close Document</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOpenEditorsCmdSet" id="OpenEditorsContextCloseAllCommandId" priority="0x0130" type="Button">
        <Parent guid="guidOpenEditorsCmdSet" id="OpenEditorsContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="CloseAll" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Close All Documents</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

